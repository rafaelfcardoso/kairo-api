# Environment
# Can be: local, development, staging, production
NODE_ENV=local

# Server
PORT=3001

# Database - Choose either Railway variables or local variables
# Option 1: Railway PostgreSQL variables (automatically provided in Railway)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=kairo

# Option 2: Local PostgreSQL variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=kairo

# JWT
JWT_SECRET=your_jwt_secret_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# API URL (automatically provided by Railway in deployment)
RAILWAY_STATIC_URL=http://localhost:3001

# Logging
# Can be: error, warn, info, debug, verbose
LOG_LEVEL=debug

# API Configuration
# Service key for authenticating AI and other external services
# This should be a long, random string and different for each environment
# You can generate one using: openssl rand -hex 32
ZENITH_API_KEY=your_service_key_here

# Optional - defaults are provided in configuration.ts
API_URL=http://localhost:3001

# Frontend URL for redirects after authentication
FRONTEND_URL=http://localhost:3000

# Apple Authentication
# Required for Sign in with Apple functionality
# For Railway deployment, APPLE_PRIVATE_KEY_BASE64 is recommended over APPLE_PRIVATE_KEY_PATH
APPLE_CLIENT_ID=your.services.id                           # The Services ID from Apple Developer Portal
APPLE_TEAM_ID=ABCDE12345                                   # Your Team ID from Apple Developer Portal (10 characters)
APPLE_KEY_ID=KLMN67890O                                    # The Key ID for your Sign in with Apple key (10 characters)
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey_KLMN67890O.p8        # Local path to your private key file (local dev only)
APPLE_CALLBACK_URL=http://localhost:3001/auth/apple/callback

# For Railway deployment - Base64 encoded private key
# Generate with: cat AuthKey_KEYID.p8 | base64
# This replaces the need for APPLE_PRIVATE_KEY_PATH in deployment environments
APPLE_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JR1RBZ0VBTUJNQQo8QmFzZTY0IGVuY29kZWQgQXBwbGUgcHJpdmF0ZSBrZXkgY29udGVudD4KLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQ== 