# Environment
# Can be: local, development, staging, production
NODE_ENV=local

# Server
PORT=3001

# Database - Choose either Railway variables or local variables
# Option 1: Railway PostgreSQL variables (automatically provided in Railway)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=zenith_db

# Option 2: Local PostgreSQL variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=zenith_db

# JWT
JWT_SECRET=your_jwt_secret_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# API URL (automatically provided by Railway in deployment)
RAILWAY_STATIC_URL=http://localhost:3001

# Logging
# Can be: error, warn, info, debug, verbose
LOG_LEVEL=debug

# API Configuration
# Service key for authenticating AI and other external services
# This should be a long, random string and different for each environment
# You can generate one using: openssl rand -hex 32
API_SERVICE_KEY=your_service_key_here

# Optional - defaults are provided in configuration.ts
API_URL=http://localhost:3001 