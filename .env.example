# Environment
# Can be: local, development, staging, production
NODE_ENV=local

# Server
PORT=3001

# Database - Choose either individual connection parameters or URL
# Option 1: Individual connection parameters (used in local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=zenith_db

# Option 2: Connection URL (used in development, staging, production)
DATABASE_PUBLIC_URL=postgresql://user:password@host:port/database

# JWT
JWT_SECRET=your_secret_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
# Can be: error, warn, info, debug, verbose
LOG_LEVEL=info

# API
# Optional - defaults are provided in configuration.ts
API_URL=http://localhost:3001 