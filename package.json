{
  "name": "zenith-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelfcardoso/zenith-api-nest.git"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/jest-standard.json",
    "test:watch": "jest --config ./test/jest-standard.json --watch",
    "test:cov": "jest --config ./test/jest-standard.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:env": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json",
    "test:e2e:setup": "ts-node -r tsconfig-paths/register scripts/setup-test-db.ts",
    "test:functional": "cross-env NODE_ENV=test jest --config ./test/jest-functional.json",
    "test:domain": "jest --config ./test/jest-domain.json",
    "test:domain:cov": "jest --config ./test/jest-domain.json --coverage",
    "test:application": "jest --config ./test/jest-application.json",
    "test:application:cov": "jest --config ./test/jest-application.json --coverage",
    "test:infrastructure": "jest --config ./test/jest-infrastructure.json",
    "test:infrastructure:skip-typecheck": "TS_NODE_TRANSPILE_ONLY=1 jest --config ./test/jest-infrastructure.json",
    "test:infrastructure:cov": "jest --config ./test/jest-infrastructure.json --coverage",
    "test:interface": "jest --config ./test/jest-interface.json",
    "test:interface:skip-typecheck": "TS_NODE_TRANSPILE_ONLY=1 jest --config ./test/jest-interface.json",
    "test:interface:cov": "jest --config ./test/jest-interface.json --coverage",
    "test:layers:cov": "jest --config ./test/jest-domain.json --coverage && jest --config ./test/jest-application.json --coverage && jest --config ./test/jest-infrastructure.json --coverage",
    "test:reminder": "ts-node -r tsconfig-paths/register src/test-reminder.ts",
    "validate:reminder": "ts-node -r tsconfig-paths/register src/reminder-validation.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:run:test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register src/scripts/migrate-test-db.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/typeorm.config.ts",
    "migration:verify": "ts-node src/scripts/verify-migrations.ts",
    "db:verify-schema": "ts-node -r tsconfig-paths/register src/scripts/verify-database-schema.ts",
    "predeploy": "npm run migration:verify && npm run db:verify-schema && npm run migration:run:test",
    "deploy": "railway up",
    "verify:migrations": "ts-node scripts/verify-migrations.ts",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:ignore-ts": "ts-node --transpile-only ./node_modules/.bin/jest --config ./test/jest-standard.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^6.4.0",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "moment-timezone": "^0.5.47",
    "nodemailer": "^6.10.0",
    "parse5-htmlparser2-tree-adapter": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "xss": "^1.0.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/moment-timezone": "^0.5.13",
    "@types/node": "^22.14.0",
    "@types/passport-local": "^1.0.38",
    "@types/rrule": "^2.1.7",
    "@types/supertest": "^6.0.0",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chardet": "^2.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "external-editor": "^3.1.0",
    "figures": "^6.1.0",
    "glob": "^10.3.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
