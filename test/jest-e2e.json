{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json",
        "allowJs": true
      }
    ]
  },
  "setupFiles": ["../setup-env.js"],
  "forceExit": true,
  "detectOpenHandles": true,
  "testTimeout": 30000
}
