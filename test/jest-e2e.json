{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFilesAfterEnv": ["jest.setup.ts"],
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "coverage/e2e",
  "testEnvironment": "node",
  "globals": {
    "ts-jest": {
      "tsconfig": "test/tsconfig.e2e.json"
    }
  }
}
